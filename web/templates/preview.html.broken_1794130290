let cmdSel = 0;
function openCmd() {
  document.getElementById('cmd-palette').classList.add('on');
  document.getElementById('cmd-inp').value = '';
  document.getElementById('cmd-inp').focus();
  filterCmd();
}
function closeCmd() { document.getElementById('cmd-palette').classList.remove('on'); }
function filterCmd() {
  const q = document.getElementById('cmd-inp').value.toLowerCase();
  const filtered = CMD_ITEMS.filter(i => i.t.toLowerCase().includes(q));
  cmdSel = 0;
  document.getElementById('cmd-list').innerHTML = filtered.map((i,idx) =>
    `<div class="cmd-item ${idx===0?'sel':''}" onclick="go('${i.go}');closeCmd()"><i class="ph ${i.ic}"></i>${i.t}</div>`
  ).join('') || '<div style="padding:20px;text-align:center;color:var(--mt)">مفيش نتائج</div>';
}
document.addEventListener('keydown', e => {
  if ((e.ctrlKey || e.metaKey) && e.key === 'k') { e.preventDefault(); openCmd(); }
  if (e.key === '/' && !['INPUT','TEXTAREA'].includes(document.activeElement.tagName)) { e.preventDefault(); openCmd(); }
  if (e.key === 'Escape') closeCmd();
  if (document.getElementById('cmd-palette').classList.contains('on')) {
    const items = document.querySelectorAll('.cmd-item');
    if (e.key === 'ArrowDown') { e.preventDefault(); cmdSel = Math.min(cmdSel+1, items.length-1); items.forEach((it,i)=>it.classList.toggle('sel', i===cmdSel)); }
    if (e.key === 'ArrowUp') { e.preventDefault(); cmdSel = Math.max(cmdSel-1, 0); items.forEach((it,i)=>it.classList.toggle('sel', i===cmdSel)); }
    if (e.key === 'Enter' && items[cmdSel]) items[cmdSel].click();
  }
});


