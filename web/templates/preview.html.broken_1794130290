<script>
let S={u:null,o:false,p:'chat'};let snding=false;const H={'ngrok-skip-browser-warning':'true'};

function playTTS(el, text) {
    if (!('speechSynthesis' in window)) {
        tst('متصفحك مش بيدعم الصوت', 'er');
        return;
    }
    if (speechSynthesis.speaking) {
        speechSynthesis.cancel();
        el.innerHTML = '<i class="ph ph-speaker-high"></i> استماع';
        return;
    }
    const clean = text.replace(/[*_`#>\-]/g, '').replace(/```[\s\S]*?```/g, '').slice(0, 500);
    if (!clean.trim()) return;
    const utt = new SpeechSynthesisUtterance(clean);
    utt.lang = 'ar-SA';
    utt.rate = 0.95;
    utt.pitch = 1;
    const voices = speechSynthesis.getVoices();
    const arVoice = voices.find(v => v.lang.startsWith('ar'));
    if (arVoice) utt.voice = arVoice;
