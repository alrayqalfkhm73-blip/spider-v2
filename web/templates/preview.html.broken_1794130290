document.addEventListener('click',function(e){
  const t=e.target.closest('.bt,.ib,.snd,.nv');
  if(!t)return;
  const r=document.createElement('span');
  const rect=t.getBoundingClientRect();
  const s=Math.max(rect.width,rect.height);
  r.style.cssText='position:absolute;width:'+s+'px;height:'+s+'px;background:rgba(255,255,255,.4);border-radius:50%;transform:scale(0);animation:rip .6s ease-out;pointer-events:none;left:'+(e.clientX-rect.left-s/2)+'px;top:'+(e.clientY-rect.top-s/2)+'px;';
  if(getComputedStyle(t).position==='static')t.style.position='relative';
  t.style.overflow='hidden';
  t.appendChild(r);
  setTimeout(()=>r.remove(),600);
});
