.nv i{font-size:16px;transition:all .3s cubic-bezier(.4,0,.2,1);display:inline-block}.nv:hover i{transform:scale(1.2) rotate(-8deg);filter:drop-shadow(0 0 8px var(--p1))}.nv.on i{animation:iconPulse 2s infinite;filter:drop-shadow(0 0 10px var(--p1))}@keyframes iconPulse{0%,100%{transform:scale(1)}50%{transform:scale(1.15)}}
.sbf{padding:10px;border-top:1px solid var(--bd)}
.mn{flex:1;display:flex;flex-direction:column;min-width:0}
.tb{min-height:52px;background:var(--pn);border-bottom:1px solid var(--bd);display:flex;align-items:center;justify-content:space-between;padding:8px 12px;padding-top:calc(8px + env(safe-area-inset-top,0px));flex-shrink:0;backdrop-filter:blur(20px);position:relative;z-index:50}.tb::after{content:"";position:absolute;bottom:-1px;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,var(--p1),transparent);opacity:.6}
.ib{width:34px;height:34px;border-radius:8px;border:1px solid var(--bd);background:var(--cd);color:var(--tx);cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:15px;transition:all .2s}.ib:hover{transform:rotate(15deg) scale(1.1);color:var(--p1);border-color:var(--p1)}.ib:active{transform:scale(.9)}
.ib:hover{background:var(--p1);color:#fff}
.pts{background:rgba(245,158,11,.15);color:var(--wn);padding:4px 10px;border-radius:8px;font-weight:900;font-size:11px}
.vw{display:none;flex:1;overflow-y:auto;flex-direction:column}
.vw.on{display:flex;animation:pgIn .4s cubic-bezier(.4,0,.2,1)}@keyframes pgIn{from{opacity:0;transform:translateY(20px) scale(.98)}to{opacity:1;transform:translateY(0) scale(1)}}
@keyframes fi{from{opacity:0;transform:translateY(5px)}to{opacity:1;transform:none}}
.pi{max-width:900px;margin:0 auto;width:100%;padding:14px}
.pt{font-size:19px;font-weight:900;margin-bottom:12px;display:flex;gap:6px;align-items:center}
</style>

<style>
