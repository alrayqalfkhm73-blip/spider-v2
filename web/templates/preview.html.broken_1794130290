        x.beginPath();x.moveTo(cx,cy);x.arc(cx,cy,r,i*A,(i+1)*A);
        x.fillStyle=prizes[i].c;x.fill();x.strokeStyle='#000';x.lineWidth=3;x.stroke();
        x.save();x.translate(cx,cy);x.rotate(i*A+A/2);x.textAlign='right';x.fillStyle='#fff';x.font='bold 18px Cairo';
        x.fillText(prizes[i].l,r-18,7);x.restore();
    }
    x.beginPath();x.arc(cx,cy,16,0,7);x.fillStyle='#8b5cf6';x.fill();x.strokeStyle='#fff';x.lineWidth=2;x.stroke();
}

let wheelAngle=0;
async function sw(){
    const b=document.getElementById('wbt');
    if(b.disabled)return;
    b.disabled=true;b.textContent='⏳';
    try{
        const r=await fetch('/api/web/wheel/spin',{method:'POST',headers:H});
        const d=await r.json();
        if(d.error){tst(d.error,'er');b.disabled=false;b.textContent='🎡 لف';return;}
        const idx=d.idx||0;
        const A=360/8,sectorCenter=idx*A+A/2,pointerAngle=270,spins=5;
        const targetMod=((pointerAngle-sectorCenter)%360+360)%360;
        const currentMod=wheelAngle%360;
        let delta=(targetMod-currentMod+360)%360;
        if(delta===0)delta=360;
        wheelAngle+=spins*360+delta;
        const canvas=document.getElementById('wcv');
        canvas.style.transform=`rotate(${wheelAngle}deg)`;
        setTimeout(()=>{
            b.disabled=false;b.textContent='🎡 لف';
            if(d.won>0){
                document.getElementById('wr').textContent='🎉 ربحت '+d.won+' نقطة!';
                document.getElementById('wr').style.color='var(--ok)';
                const cur=parseInt(document.getElementById('tp').textContent)||0;
                document.getElementById('tp').textContent=(cur+d.won)+' 🪙';
                tst('🎉 ربحت '+d.won,'ok');
            }else{
                document.getElementById('wr').textContent='😔 حظ أوفر';
                document.getElementById('wr').style.color='var(--mt)';
            }
        },4200);
    }catch(e){b.disabled=false;b.textContent='🎡 لف';tst('فشل','er');}
}

