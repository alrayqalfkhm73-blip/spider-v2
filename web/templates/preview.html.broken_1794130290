body{background:var(--bg);color:var(--tx);height:100vh;height:100dvh;display:flex;overflow:hidden}
.sb{width:220px;background:var(--pn);border-left:1px solid var(--bd);position:fixed;right:0;top:0;bottom:0;z-index:100;transform:translateX(100%);transition:transform .3s;display:flex;flex-direction:column}
